{
	email admin@revoai.info
	# Allow serving HTTP on specific sites without auto-redirect to HTTPS.
	auto_https off
}

# Temporary: serve the app over plain HTTP on the VPS IP so phones on
# networks that block port 3000 can still reach it. Swap to HTTPS-only once
# DNS is configured and a cert has been issued for app.revoai.info.
:80 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3001
	}

	handle /socket.io/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

# HTTPS on the real domain. Caddy will auto-obtain Let's Encrypt cert once
# DNS resolves to this VPS. Same routing as port 80.
app.revoai.info {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3001
	}

	handle /socket.io/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
