# ---------------------------------------------------------------------------
# Mission Control — environment template
# Copy to `.env` and fill in real values. Never commit the populated .env.
# Required vars are flagged; missing ones will fail `npm run sanity:env`.
#
# SECURITY NOTES — read before filling in:
#   1. Generate each secret marked <generate> with a strong random value, e.g.:
#        openssl rand -hex 32                  # 64 hex chars, good for any secret
#        openssl rand -base64 24               # url-safe alternative
#      Never ship an `.env` where any value below is literally the word
#      `change-me`, `<generate>`, or an empty string.
#   2. After bootstrap, ADMIN_PASSWORD / BOOTSTRAP_ADMIN_PASSWORD must not be
#      mutated without also resetting the admin user's password hash in the
#      database — the bootstrap endpoint is idempotent on email only, so a
#      changed password here will NOT propagate.
#   3. ADMIN_TOKEN and NEXT_PUBLIC_ADMIN_TOKEN MUST be equal. The token is
#      shared between the web shell and the API; `sanity:env` verifies this.
#   4. If any value contains shell-special characters (spaces, `'`, `"`, `$`,
#      backtick), either avoid them (regenerate) or wrap the whole value in
#      double quotes. Do NOT rely on `source .env` to load these safely;
#      prefer `node --env-file=.env` or `docker compose --env-file .env`.
#      See HANDOFF.md §2 for loading recipes.
# ---------------------------------------------------------------------------

# --- Core API (required) ----------------------------------------------------
DATABASE_URL=postgresql://mission:mission@postgres:5432/mission_control
REDIS_URL=redis://redis:6379
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# --- Admin / Auth (required) ------------------------------------------------
# Pick a strong admin password. If you must use shell-special chars, quote
# the entire value with double quotes: ADMIN_PASSWORD="s0me-Value'With#Chars".
ADMIN_MODE=single
ADMIN_EMAIL=admin@revoai.local
ADMIN_PASSWORD=<generate>
ADMIN_TOKEN=<generate>
BOOTSTRAP_ADMIN_EMAIL=admin@revoai.local
BOOTSTRAP_ADMIN_PASSWORD=<generate>
SESSION_SECRET=<generate>
PASSWORD_SALT=<generate>
SECRET_KEY=<generate>

# --- Web (required) ---------------------------------------------------------
# NEXT_PUBLIC_ADMIN_TOKEN MUST equal ADMIN_TOKEN above.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_URL=http://api:3001
NEXT_PUBLIC_ADMIN_TOKEN=change-me
PUBLIC_API_BASE=http://localhost:3001
PUBLIC_APP_BASE=http://localhost:3000

# --- Email / SMTP -----------------------------------------------------------
OAUTH_STUB_MODE=1
EMAIL_FROM=you@yourdomain.com
EMAIL_SMTP_HOST=smtp.ionos.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=you@yourdomain.com
EMAIL_SMTP_PASS=
EMAIL_WEBHOOK_SECRET=
EMAIL_PROVIDER_SEND_URL=
EMAIL_PROVIDER_VALIDATE_URL=
EMAIL_OAUTH_AUTH_URL=
EMAIL_OAUTH_TOKEN_URL=
EMAIL_OAUTH_CALLBACK_URL=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_SCOPES=

# --- LinkedIn ---------------------------------------------------------------
LINKEDIN_STUB_MODE=1
LINKEDIN_DM_STUB_MODE=1
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTH_URL=
LINKEDIN_TOKEN_URL=
LINKEDIN_CALLBACK_URL=
LINKEDIN_SCOPES=
LINKEDIN_SHARE_URL=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_SECRET=

# --- Facebook ---------------------------------------------------------------
FACEBOOK_STUB_MODE=1
FACEBOOK_PUBLISH_STUB_MODE=1
FACEBOOK_INSIGHTS_STUB_MODE=1
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_AUTH_URL=
FACEBOOK_TOKEN_URL=
FACEBOOK_CALLBACK_URL=
FACEBOOK_SCOPES=
FACEBOOK_PAGE_ID=
FACEBOOK_FEED_URL=
FACEBOOK_TOKEN_SECRET=

# --- Research / enrichment providers ---------------------------------------
APOLLO_API_KEY=
HUNTER_API_KEY=
UNIPILE_API_KEY=
UNIPILE_DM_SEND_URL=
GOOGLE_MAPS_API_KEY=

# --- Test / smoke / UAT overrides ------------------------------------------
# (Leave blank in normal runs; scripts fall back to defaults.)
SMOKE_BASE_URL=
SMOKE_ADMIN_TOKEN=
TEST_API_BASE=
TEST_WEB_BASE=
TEST_ADMIN_TOKEN=
UAT_API_BASE=
UAT_WEB_BASE=
UAT_ADMIN_EMAIL=
UAT_ADMIN_PASSWORD=
UAT_ADMIN_TOKEN=
