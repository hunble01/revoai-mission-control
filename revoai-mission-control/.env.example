# API
DATABASE_URL=postgresql://mission:mission@postgres:5432/mission_control
REDIS_URL=redis://redis:6379
PORT=3001
ADMIN_MODE=single
ADMIN_EMAIL=admin@revoai.local
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me

# EMAIL (IONOS SMTP or other SMTP)
OAUTH_STUB_MODE=0
EMAIL_FROM=you@yourdomain.com
EMAIL_SMTP_HOST=smtp.ionos.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=you@yourdomain.com
EMAIL_SMTP_PASS=app-password-or-mailbox-password

# WEB
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
INTERNAL_API_URL=http://api:3001
NEXT_PUBLIC_ADMIN_TOKEN=change-me
