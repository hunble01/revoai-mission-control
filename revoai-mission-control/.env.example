# ---------------------------------------------------------------------------
# Mission Control — environment template
# Copy to `.env` and fill in real values. Never commit the populated .env.
# Required vars are flagged; missing ones will fail `npm run sanity:env`.
# ---------------------------------------------------------------------------

# --- Core API (required) ----------------------------------------------------
DATABASE_URL=postgresql://mission:mission@postgres:5432/mission_control
REDIS_URL=redis://redis:6379
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# --- Admin / Auth (required) ------------------------------------------------
ADMIN_MODE=single
ADMIN_EMAIL=admin@revoai.local
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me
BOOTSTRAP_ADMIN_EMAIL=admin@revoai.local
BOOTSTRAP_ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me
PASSWORD_SALT=change-me
SECRET_KEY=change-me

# --- Web (required) ---------------------------------------------------------
# NEXT_PUBLIC_ADMIN_TOKEN MUST equal ADMIN_TOKEN above.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_URL=http://api:3001
NEXT_PUBLIC_ADMIN_TOKEN=change-me
PUBLIC_API_BASE=http://localhost:3001
PUBLIC_APP_BASE=http://localhost:3000

# --- Email / SMTP -----------------------------------------------------------
OAUTH_STUB_MODE=1
EMAIL_FROM=you@yourdomain.com
EMAIL_SMTP_HOST=smtp.ionos.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=you@yourdomain.com
EMAIL_SMTP_PASS=
EMAIL_WEBHOOK_SECRET=
EMAIL_PROVIDER_SEND_URL=
EMAIL_PROVIDER_VALIDATE_URL=
EMAIL_OAUTH_AUTH_URL=
EMAIL_OAUTH_TOKEN_URL=
EMAIL_OAUTH_CALLBACK_URL=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_SCOPES=

# --- LinkedIn ---------------------------------------------------------------
LINKEDIN_STUB_MODE=1
LINKEDIN_DM_STUB_MODE=1
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTH_URL=
LINKEDIN_TOKEN_URL=
LINKEDIN_CALLBACK_URL=
LINKEDIN_SCOPES=
LINKEDIN_SHARE_URL=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_SECRET=

# --- Facebook ---------------------------------------------------------------
FACEBOOK_STUB_MODE=1
FACEBOOK_PUBLISH_STUB_MODE=1
FACEBOOK_INSIGHTS_STUB_MODE=1
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_AUTH_URL=
FACEBOOK_TOKEN_URL=
FACEBOOK_CALLBACK_URL=
FACEBOOK_SCOPES=
FACEBOOK_PAGE_ID=
FACEBOOK_FEED_URL=
FACEBOOK_TOKEN_SECRET=

# --- Research / enrichment providers ---------------------------------------
APOLLO_API_KEY=
HUNTER_API_KEY=
UNIPILE_API_KEY=
UNIPILE_DM_SEND_URL=
GOOGLE_MAPS_API_KEY=

# --- Test / smoke / UAT overrides ------------------------------------------
# (Leave blank in normal runs; scripts fall back to defaults.)
SMOKE_BASE_URL=
SMOKE_ADMIN_TOKEN=
TEST_API_BASE=
TEST_WEB_BASE=
TEST_ADMIN_TOKEN=
UAT_API_BASE=
UAT_WEB_BASE=
UAT_ADMIN_EMAIL=
UAT_ADMIN_PASSWORD=
UAT_ADMIN_TOKEN=
