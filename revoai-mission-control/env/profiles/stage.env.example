# RevoAI Mission Control - Staging profile
# Mirrors production topology with non-production secrets.

# API
NODE_ENV=staging
DATABASE_URL=postgresql://<user>:<password>@<stage-db-host>:5432/mission_control
REDIS_URL=redis://<stage-redis-host>:6379
PORT=3001
ADMIN_MODE=single
ADMIN_EMAIL=admin@revoai.stage
ADMIN_PASSWORD=<stage-admin-password>
ADMIN_TOKEN=<stage-admin-token>

# WEB
NEXT_PUBLIC_API_URL=https://<stage-api-domain>
NEXT_PUBLIC_WS_URL=wss://<stage-api-domain>
INTERNAL_API_URL=http://api:3001
NEXT_PUBLIC_ADMIN_TOKEN=<stage-admin-token>
