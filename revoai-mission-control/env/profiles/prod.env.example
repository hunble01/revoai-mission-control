# RevoAI Mission Control - Production profile
# Production-safe placeholders only. Do not commit real secrets.

# API
NODE_ENV=production
DATABASE_URL=postgresql://<user>:<password>@<prod-db-host>:5432/mission_control
REDIS_URL=redis://<prod-redis-host>:6379
PORT=3001
ADMIN_MODE=single
ADMIN_EMAIL=admin@revoai.local
ADMIN_PASSWORD=<prod-admin-password>
ADMIN_TOKEN=<prod-admin-token>

# WEB
NEXT_PUBLIC_API_URL=https://<prod-api-domain>
NEXT_PUBLIC_WS_URL=wss://<prod-api-domain>
INTERNAL_API_URL=http://api:3001
NEXT_PUBLIC_ADMIN_TOKEN=<prod-admin-token>
